{
    "name": "acme/app",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "acme/laravel-ext": "^2.0",
        "acme/lib": "^1.4",
        "acme/meta": "^1.0"
    },
    "require-dev": {
        "acme/testkit": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
